# Smart Inventory Backend Environment Configuration Template
# Copy this file to .env for local development, or add these in Vercel Project Settings > Environment Variables

# Local server port (optional on Vercel)
PORT=5000

# Allowed CORS Origins (comma-separated if multiple, e.g. http://localhost:5173,https://your-domain.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Strong JWT Secret Key (Required for production authentication)
JWT_SECRET=

# MongoDB Atlas Connection String (Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart-inventory?retryWrites=true&w=majority)
MONGODB_URI=

# External Smartphone Suggestion Provider Configuration (Optional)
SMARTPHONE_SUGGESTION_API_KEY=
SMARTPHONE_SUGGESTION_PROVIDER=catalog_provider

